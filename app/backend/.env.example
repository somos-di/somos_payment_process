# Backend Processo de Pagamento — copie para .env e preencha (o .env NÃO é versionado)
PORT=4000
HOST=0.0.0.0
# origens permitidas (CORS). O front é same-origin via nginx; informe a origem
# usada no navegador. PRODUÇÃO (ngrok): https://pagamentos.ngrok.dev
# DEV local: http://localhost:8080
CORS_ORIGIN=https://pagamentos.ngrok.dev

SUPABASE_URL=https://xxxx.supabase.co
# anon/publishable (pública) — usada para agir EM NOME do usuário (com o JWT dele)
SUPABASE_ANON_KEY=sb_publishable_xxx
# secret (service_role) — SÓ no backend; operações privilegiadas (ex.: integração UAU)
SUPABASE_SERVICE_KEY=sb_secret_xxx
SUPABASE_SCHEMA=payment

# sessão em cookie httpOnly (sem token no front). COOKIE_SECURE=true em HTTPS
# (produção via ngrok). Use false só em dev local sem TLS (http://localhost).
SESSION_COOKIE=pp_session
COOKIE_SECURE=true
ATTACHMENTS_BUCKET=attachments

# UAU (sync)
UAU_BASE_URL=http://your-uau-host:port/uauAPI
UAU_USER=your-uau-user
UAU_PASSWORD=your-uau-password
UAU_X_INTEGRATION=your-x-integration-jwt
UAU_TIMEOUT_MS=30000
